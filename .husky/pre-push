remote="$1"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Pushing to main: pushing Supabase migrations first..."
    npx supabase db push || {
      echo "Supabase migration push failed - aborting git push." >&2
      exit 1
    }
  fi
done
